# 本地开发用配置。首次运行 scripts/db.sh 会自动复制为 .env
# 注意：以下均为开发环境口令，上线前务必替换

TZ=Asia/Shanghai

# 镜像加速地址：国内直连 Docker Hub 常失败，可换成可用镜像站；留空则用官方源
# 已验证可用：swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io
# 其他候选：docker.m.daocloud.io、docker.1ms.run（仅镜像 library/* 官方镜像）
REGISTRY_MIRROR=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io

# ---- PostgreSQL ----
# 必须用带 pgvector 的镜像：官方 postgres:*-alpine 不含 vector 扩展，
# 会导致 create extension vector 失败、向量检索完全不可用。
# 可选值：
#   pgvector/pgvector:pg16                      （推荐，Debian 基础）
#   改为 alpine 版本需自行确认已内置 vector 扩展
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_USER=wt
POSTGRES_PASSWORD=wt_dev_pg_2024
POSTGRES_DB=wt_dev
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=wt_dev_redis_2024
REDIS_PORT=6379

# ---- MinIO (S3 兼容对象存储) ----
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=wtadmin
MINIO_ROOT_PASSWORD=wt_dev_minio_2024
MINIO_BUCKET=wt-dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
